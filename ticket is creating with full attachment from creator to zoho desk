			certHolderName = certFullData.get("Certification_Holder_s_Name");
			certNumber = certFullData.get("Certification");
			certIdentifier = certHolderName + " - Cert #" + certNumber;
			if(certIdentifier.trim() == " - Cert #")
			{
				certIdentifier = "Certification Row #" + certRowID;
			}
			info "Processing certification: " + certIdentifier;
			// Get the file upload field from this certification row
			certFileUpload = certFullData.get("Upload_a_copay_of_Certification");
			// Check if it's an array (multiple files) or single file
			if(certFileUpload != null)
			{
				// If it's a list, loop through each file
				if(certFileUpload.size() > 0)
				{
					info "Found " + certFileUpload.size() + " file(s) for " + certIdentifier;
					for each  certFilePath in certFileUpload
					{
						if(certFilePath != null && certFilePath != "")
						{
							info "Processing file: " + certFilePath;
							// Remove /api/v2.1/ from the beginning and construct URL
							cleanPath = certFilePath.replaceFirst("/api/v2.1/","");
							downloadCertFileUrl = "https://www.zohoapis.com/creator/v2.1/data/" + cleanPath;
							info "Download URL (Certification File): " + downloadCertFileUrl;
							// Try to download the file (with error handling for large files)
							try 
							{
								// Download the file
								certFileResp = invokeurl
								[
									url :downloadCertFileUrl
									type :GET
									connection:"zohocreator"
								];
								info "Certification file downloaded for: " + certIdentifier;
								// Set param name
								certFileResp.setParamName("file");
								// Upload to Desk
								certFileUploadResponse = invokeurl
								[
									url :"https://desk.zoho.com/api/v1/tickets/" + ticketId + "/attachments"
									type :POST
									parameters:{"file":certFileResp}
									connection:"zohodesk"
									content-type:"multipart/form-data"
								];
								uploadResults.add({"type":"Certification_File","certification":certIdentifier,"status":"success","response":certFileUploadResponse});
								info "Certification file uploaded for " + certIdentifier + ": " + certFileUploadResponse;
							}
							catch (e)
							{
								// File is too large or other error
								info "SKIPPED - File too large or error: " + certFilePath;
								skippedFiles.add({"certification":certIdentifier,"file":certFilePath,"reason":"File size > 5MB or download error"});
							}
						}
					}
				}
				else
				{
					info "File upload field is empty for: " + certIdentifier;
				}
			}
			else
			{
				info "No file upload field found for certification: " + certIdentifier;
			}
		}
	}
	else
	{
		info "No Employee Professional Certification found or subform is empty";
	}
	info "=== CERTIFICATION FILES UPLOAD RESULTS ===";
	info "Total certification files uploaded: " + uploadResults.size();
	info "Total files skipped (>5MB): " + skippedFiles.size();
	info uploadResults;
	if(skippedFiles.size() > 0)
	{
		info "=== SKIPPED FILES ===";
		info skippedFiles;
	}
	info "Total uploaded: " + uploadResults.size() + " | Skipped (>5MB): " + skippedFiles.size();
	//
	}
	catch (e)
	{
		info "❌ ERROR: " + e;
	}
}
